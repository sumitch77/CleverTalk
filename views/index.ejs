<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CleverTalk</title>
  <link rel="stylesheet" href="/main.css" />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <aside class="sidebar">


    <div class="brand">
      <span class="brand-text">CleverTalk</span>
      <span class="brand-dot"></span>
      <div class="settings-btn" aria-label="Settings">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
      </div>

    </div>

      <div class="setting-option">
        <button class="dark-mode-btn" id="darkModeBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
          Dark Mode
        </button>
       <a href="/logout"> <button class="logout" id="logoutBtn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
          Logout
        </button></a>
      </div>
    


    <!-- Profile avatar (click to open panel) -->
    <div class="profile-wrap">
      <button class="avatar-btn" id="avatarBtn" aria-label="Open profile panel">
          <p class="pp-username"><%= user.username %></p>
        <img src="<%= user.profilePic || '/default-2820-pp.jpeg' %>" alt="<%= user.username %>" class="avatar-img" />
        <span class="avatar-ring"></span>
        <span class="online-dot"></span>
      </button>
    

      <!-- Dropdown panel -->
      <div class="profile-panel" id="profilePanel">
        <div class="pp-header">
         
          <img src="<%= user.profilePic || '/default-2820-pp.jpeg' %>" alt="<%= user.username %>" class="pp-avatar" />
          <div class="pp-info">
            <p class="pp-username">@<%= user.username %></p>
            <p class="pp-status">Online</p>
          </div>
        </div>

        <div class="pp-stats">
          <!-- Fill in your data here -->
          <div class="stat-item">
            <span class="stat-value">—</span>
            <span class="stat-label">Messages</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">—</span>
            <span class="stat-label">Contacts</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">—</span>
            <span class="stat-label">Groups</span>
          </div>
        </div>

        <div class="pp-actions">
          <a href="/logout" class="pp-btn pp-logout">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Logout
          </a>
        </div>
      </div>
    </div>

    <!-- Search -->
    <div class="search-wrap">
      <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" class="search-input" id="searchInput" placeholder="Search contacts…" />
    </div>

    <!-- Contacts list -->
    <nav class="contacts-list" id="contactsList">
      <p class="contacts-label" style="display:none;">Contacts</p>

      <% users.forEach(function(contact) { %>
        <button class="contact-item" data-id="<%= contact._id %>" data-name="<%= contact.name1 %>" onclick="openChat('<%= contact._id %>', '<%= contact.name1 %>', '<%= contact.status %>')">
          <div class="contact-avatar">
            <img src="<%= user.profilePic || '/default-2820-pp.jpeg' %>" alt="<%= user.username %>" class="avatar-img" />
            <span class="contact-status-dot <%= contact.status %>"></span>
          </div>
          <div class="contact-info">
            <p class="contact-name"><%= contact.name1 %></p>
            <p class="contact-last"><%= contact.lastMsg %></p>
          </div>
        </button>
      <% }); %>
    </nav>

  </aside>

  <!-- ── Chat area ── -->
  <main class="chat-area" id="chatArea">
    <div class="chat-empty" id="chatEmpty">
      <div class="empty-icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </div>
      <p class="empty-title">No chat selected</p>
      <p class="empty-sub">Pick a contact to start talking</p>
    </div>

    <div class="chat-window" id="chatWindow" style="display:none;">
      <div class="chat-header" id="chatHeader">
        <button class="back-btn" id="backBtn" onclick="showSidebar()">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <polyline points="15 18 9 12 15 6"/>
  </svg>
</button>
        <div class="chat-header-avatar" id="chatHeaderAvatar"></div>
        <div>
          <p class="chat-header-name" id="chatHeaderName">—</p>
          <p class="chat-header-status" id="chatHeaderStatus">—</p>
        </div>
      </div>
      
      <div class="chat-messages" id="chatMessages">
        <!-- messages will populate here -->
      </div>
      <div class="chat-input-bar">
        <input type="text" id="chatinput1" class="chat-input" name="message" placeholder="Type a message…" />
        <button id="send-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </div>
    </div>
  </main>

  <script src="/index.js"></script>

</body>
</html>
